--Trigger: burnar.defnarvip.trg_defnarvip_upd

/* DROP TRIGGER trg_defnarvip_upd
  ON burnar.defnarvip; */

CREATE TRIGGER trg_defnarvip_upd
  BEFORE UPDATE
  ON burnar.defnarvip
  FOR EACH ROW
  EXECUTE PROCEDURE burnar.ftrg_defnarvip_upd();


declare
--rec record;
begin

  if new.closed = 1 then
    new.closeddate := now();
  else
    new.closeddate := null;
  end if;
  
  ------логируем закрытие наряд выполенения
  if new.closed = 1 then
    insert into burnar.log_nar
    select u.users_id   --user_id
           ,now()  --log_date
           ,old.narkey    --narkey
           ,(select nm from burnar.defnar  where key = old.narkey)     
           ,6     --event
           ,current_setting('USERENV.OS_USER')::varchar 
           ,current_setting('USERENV.HOST')::varchar  
    from burnar.users u
    where u.users_id = current_setting('burnar.user_id')::numeric;
  else
    ------логируем открытие наряд выполнения          
    insert into burnar.log_nar
    select u.users_id   --user_id
           ,now()  --log_date
           ,old.narkey    --narkey
           ,(select nm from burnar.defnar  where key = old.narkey)     --nm_nar
           ,7     --event
           ,current_setting('USERENV.OS_USER')::varchar  --t.os_user   --os_user
           ,current_setting('USERENV.HOST')::varchar  --t.machine   --machine
    from burnar.users u
    where u.users_id = current_setting('burnar.user_id')::numeric;            
  end if;

 -- хз НАДО ЛИ ЭТО!?
 --если модифицируем дату начала, надо передвинуть все даты операции выполнения, если нужно
