--Trigger: burnar.zndefnarzadatrib.trg_log_atrib_zad

/* DROP TRIGGER trg_log_atrib_zad
  ON burnar.zndefnarzadatrib; */

CREATE TRIGGER trg_log_atrib_zad
  AFTER UPDATE OR INSERT OR DELETE
  ON burnar.zndefnarzadatrib
  FOR EACH ROW
  EXECUTE PROCEDURE burnar.ftrg_log_atrib_zad();


--declare
--rec record;
begin



if TG_OP = 'INSERT' and new.defnar is not null then
    insert into burnar.log_atrib
    select u.users_id    --user_id
           ,now()        --,log_date
           ,new.defnar   --,narkey
           ,new.parcode  --,parnum
           ,4            --,event
           ,new.val      --,new_val
           ,null         --,old_val
           ,new.valstr   --,new_str
           ,null         --,old_str
           ,current_setting('USERENV.OS_USER')::varchar   --,osuser
           ,current_setting('USERENV.HOST')::varchar   --,machine
    from burnar.users u
    where u.users_id = current_setting('burnar.user_id')::numeric;
   
    RETURN new;  
end if;

if TG_OP = 'DELETE' then --if deleting then
    insert into burnar.log_atrib
    select u.users_id    --user_id
           ,now()        --,log_date
           ,old.defnar   --,narkey
           ,old.parcode  --,parnum
           ,6            --,event
           ,old.val      --,new_val
           ,null         --,old_val
