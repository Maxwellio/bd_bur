--Procedure: burnar.zadanie_set_skvparam(integer, numeric, numeric, numeric)

--DROP PROCEDURE burnar.zadanie_set_skvparam(integer, numeric, numeric, numeric);

CREATE OR REPLACE PROCEDURE burnar.zadanie_set_skvparam
(
  IN  anarkey   integer,
  IN  aparcode  numeric,
  IN  aznval    numeric,
  IN  aval      numeric
)
AS $$
--процедура проставляет значения сквозных параметров во всем наряд-заднии
declare
rec record;
begin
for rec in (
            select p.zad_key, p.parcode, ff.newval 
            from burnar.zadanie_param p, 
                 burnar.zadanie_oper o, 
                 (select c.normparorzn, coalesce((select q.normparorzn from public.common_spr q where q.id=aznval), aval)
                  newval from  public.common_spr c
                  where 
                  c.id=aparcode and c.normparorzn is not null ) ff
            where p.parcode=ff.normparorzn 
                  and o.key=p.zad_key 
                  and o.narkey=anarkey
)
loop
      --обновляем сквозные параметры
      update burnar.zadanie_param
      set znach=rec.newval
      where zad_key=rec.zad_key 
              and parcode=rec.parcode;
      --после обновления параметров норма будет удалена ибо не соотвествует текущему значению параметра
      update burnar.zadanie_norm 
      set NORMA = null 
      where ZAD_KEY = rec.zad_key;  
      -- раз удалили норму - источники ни к чему :)
      delete from burnar.zadanie_ist 
      where ZAD_KEY = rec.zad_key;
end loop;
end ;
$$
LANGUAGE 'plpgsql';

ALTER PROCEDURE burnar.zadanie_set_skvparam(integer, numeric, numeric, numeric)
  OWNER TO postgres;
